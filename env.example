# Database
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/goalflow?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/goalflow?schema=public"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# xAI API
# Get your API key from https://x.ai
XAI_API_KEY="your-xai-api-key-here"
XAI_BASE_URL="https://api.x.ai/v1"
XAI_MODEL="grok-4-latest"

# Email (Resend) - Optional for Phase 3
# RESEND_API_KEY="your-resend-api-key-here"
# EMAIL_FROM="noreply@yourdomain.com"

# App
APP_URL="http://localhost:3000"
